# Копирај го овој фајл во secrets.properties (во истата папка) и внеси го твојот клуч.
# Бесплатен Gemini API клуч: https://aistudio.google.com/apikey
# secrets.properties НЕ смее да се качува на GitHub (веќе е во .gitignore).
GEMINI_API_KEY=your-key-here

# Таен клуч за JWT токените (најмалку 32 знаци, случаен). Генерирање:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
